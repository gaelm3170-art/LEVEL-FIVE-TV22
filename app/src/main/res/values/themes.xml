<resources xmlns:tools="http://schemas.android.com/tools">
    <!--
      Activity window theme. The real UI is pure Jetpack Compose (tv-material3); this framework
      theme only governs the launch window before Compose draws, so we keep it minimal and paint the
      window the brand background to avoid a flash. App default theme is AMOLED dark.
    -->
    <style name="Theme.LevelFiveTV" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/owntv_window_bg</item>
        <item name="android:statusBarColor">@color/owntv_window_bg</item>
        <item name="android:navigationBarColor">@color/owntv_window_bg</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <!--
      Launch theme (audit ST3). The activity starts in this theme so the cold start shows the cyan
      play-mark on the same window background as Theme.LevelFiveTV — no colour flash at handoff — and
      MainActivity switches to Theme.LevelFiveTV via postSplashScreenTheme once a real destination is ready.
    -->
    <style name="Theme.LevelFiveTV.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/owntv_window_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_mark</item>
        <item name="postSplashScreenTheme">@style/Theme.LevelFiveTV</item>
    </style>
</resources>
